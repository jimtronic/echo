{
  "id":"es-co-beginner-01","language":"es","locale":"es-CO","level":"beginner","order":1,
  "title":"Introductions and essentials","description":"Short, natural phrases for greeting people, introducing yourself, and handling basic social interactions in Colombia.",
  "targetVocabulary":["hola","buenos días","buenas","qué más","todo bien","mucho gusto","gracias","qué pena","con mucho gusto","a la orden","listo","chao"],
  "lessons":[
    {"id":"es-co-beginner-01-001","sentence":"¡Buenos días!","english":"Good morning!","acceptedTranslations":["Good morning."],"audio":"/audio/es-CO/beginner/01/001.mp3","notes":["A very common polite greeting in Colombia."],"topics":["greetings","social"],"kind":"curated","family":"basic-greeting"},
    {"id":"es-co-beginner-01-002","sentence":"¡Buenas!","english":"Hi!","acceptedTranslations":["Hello!","Hi there!"],"audio":"/audio/es-CO/beginner/01/002.mp3","notes":["A very common Colombian greeting, especially when entering a shop or addressing someone you do not know well."],"topics":["greetings","spoken colombian spanish"],"kind":"curated","family":"basic-greeting"},
    {"id":"es-co-beginner-01-003","sentence":"Hola, ¿qué más?","english":"Hi, how's it going?","acceptedTranslations":["Hi, how are you?","Hey, what's up?"],"audio":"/audio/es-CO/beginner/01/003.mp3","notes":["« ¿Qué más? » is an extremely common Colombian greeting."],"topics":["greetings","spoken colombian spanish"],"kind":"curated","family":"que-mas"},
    {"id":"es-co-beginner-01-004","sentence":"Bien, gracias. ¿Y usted?","english":"Good, thanks. And you?","acceptedTranslations":["I'm well, thank you. And you?","Fine, thanks. How about you?"],"audio":"/audio/es-CO/beginner/01/004.mp3","notes":["« Usted » is widely used in Colombia, including many everyday situations where other Spanish-speaking regions might prefer « tú »."],"topics":["greetings","responses"],"kind":"curated","family":"greeting-response"},
    {"id":"es-co-beginner-01-005","sentence":"¿Todo bien?","english":"Everything good?","acceptedTranslations":["Is everything okay?","How's everything?"],"audio":"/audio/es-CO/beginner/01/005.mp3","notes":["A very common casual greeting or check-in."],"topics":["greetings","spoken colombian spanish"],"kind":"curated","family":"todo-bien"},
    {"id":"es-co-beginner-01-006","sentence":"Sí, todo bien.","english":"Yes, everything's good.","acceptedTranslations":["Yes, everything's fine.","Yeah, all good."],"audio":"/audio/es-CO/beginner/01/006.mp3","notes":["« Todo bien » works naturally as both a question and a response."],"topics":["greetings","responses"],"kind":"construction","family":"todo-bien"},
    {"id":"es-co-beginner-01-007","sentence":"Me llamo Laura.","english":"My name is Laura.","acceptedTranslations":["I'm Laura."],"audio":"/audio/es-CO/beginner/01/007.mp3","notes":["The standard way to give your name."],"topics":["introductions","social"],"kind":"construction","family":"me-llamo"},
    {"id":"es-co-beginner-01-008","sentence":"¿Cómo se llama?","english":"What's your name?","acceptedTranslations":["What is your name?"],"audio":"/audio/es-CO/beginner/01/008.mp3","notes":["A polite « usted » form for asking someone's name."],"topics":["introductions","questions"],"kind":"construction","family":"ask-name"},
    {"id":"es-co-beginner-01-009","sentence":"Mucho gusto.","english":"Nice to meet you.","acceptedTranslations":["Pleased to meet you."],"audio":"/audio/es-CO/beginner/01/009.mp3","notes":["A very common phrase when meeting someone."],"topics":["introductions","social"],"kind":"curated","family":"mucho-gusto"},
    {"id":"es-co-beginner-01-010","sentence":"Igualmente, mucho gusto.","english":"Likewise, nice to meet you.","acceptedTranslations":["Nice to meet you too.","Likewise, pleased to meet you."],"audio":"/audio/es-CO/beginner/01/010.mp3","notes":["A natural response after someone says « mucho gusto »."],"topics":["introductions","responses"],"kind":"curated","family":"mucho-gusto"},
    {"id":"es-co-beginner-01-011","sentence":"¿Usted es de aquí?","english":"Are you from here?","acceptedTranslations":["Are you from around here?","Are you local?"],"audio":"/audio/es-CO/beginner/01/011.mp3","notes":["A useful example of everyday « usted »."],"topics":["introductions","questions"],"kind":"construction","family":"usted-es"},
    {"id":"es-co-beginner-01-012","sentence":"No, soy de Estados Unidos.","english":"No, I'm from the United States.","acceptedTranslations":["No, I'm from the US.","No, I'm American."],"audio":"/audio/es-CO/beginner/01/012.mp3","notes":["« Soy de... » is the standard construction for saying where you are from."],"topics":["introductions","responses"],"kind":"construction","family":"soy-de"},
    {"id":"es-co-beginner-01-013","sentence":"Estoy aquí de vacaciones.","english":"I'm here on vacation.","acceptedTranslations":["I'm here on holiday."],"audio":"/audio/es-CO/beginner/01/013.mp3","notes":["« Estar de vacaciones » means to be on vacation."],"topics":["introductions","travel"],"kind":"curated","family":"vacation"},
    {"id":"es-co-beginner-01-014","sentence":"¿Habla inglés?","english":"Do you speak English?","acceptedTranslations":["Can you speak English?"],"audio":"/audio/es-CO/beginner/01/014.mp3","notes":["The « usted » form is useful when speaking to someone you do not know."],"topics":["language","questions"],"kind":"construction","family":"habla"},
    {"id":"es-co-beginner-01-015","sentence":"Hablo un poquito de español.","english":"I speak a little Spanish.","acceptedTranslations":["I speak a little bit of Spanish.","I speak a bit of Spanish."],"audio":"/audio/es-CO/beginner/01/015.mp3","notes":["« Un poquito » is a very natural conversational way to say a little bit."],"topics":["language","introductions"],"kind":"curated","family":"hablo"},
    {"id":"es-co-beginner-01-016","sentence":"No entiendo muy bien.","english":"I don't understand very well.","acceptedTranslations":["I don't understand that very well.","I don't quite understand."],"audio":"/audio/es-CO/beginner/01/016.mp3","notes":["A useful way to indicate that you are having trouble following."],"topics":["clarification","language"],"kind":"curated","family":"dont-understand"},
    {"id":"es-co-beginner-01-017","sentence":"¿Me puede repetir, por favor?","english":"Can you repeat that, please?","acceptedTranslations":["Could you repeat that, please?","Can you say that again, please?"],"audio":"/audio/es-CO/beginner/01/017.mp3","notes":["A polite and very useful request using « usted »."],"topics":["clarification","requests"],"kind":"construction","family":"me-puede"},
    {"id":"es-co-beginner-01-018","sentence":"Más despacio, por favor.","english":"More slowly, please.","acceptedTranslations":["A little slower, please.","Could you speak more slowly?"],"audio":"/audio/es-CO/beginner/01/018.mp3","notes":["A simple request when someone is speaking too quickly."],"topics":["clarification","requests"],"kind":"curated","family":"speak-slower"},
    {"id":"es-co-beginner-01-019","sentence":"Qué pena, tengo una pregunta.","english":"Excuse me, I have a question.","acceptedTranslations":["Sorry, I have a question.","Excuse me, can I ask you something?"],"audio":"/audio/es-CO/beginner/01/019.mp3","notes":["« Qué pena » is extremely common in Colombia as a soft, polite way to apologize, interrupt, or get someone's attention."],"topics":["social","requests","spoken colombian spanish"],"kind":"curated","family":"que-pena"},
    {"id":"es-co-beginner-01-020","sentence":"Qué pena, no escuché bien.","english":"Sorry, I didn't hear you clearly.","acceptedTranslations":["Sorry, I didn't hear that well.","Excuse me, I didn't hear you."],"audio":"/audio/es-CO/beginner/01/020.mp3","notes":["Another natural use of the high-frequency Colombian expression « qué pena »."],"topics":["clarification","spoken colombian spanish"],"kind":"construction","family":"que-pena"},
    {"id":"es-co-beginner-01-021","sentence":"Muchas gracias, muy amable.","english":"Thank you very much, that's very kind.","acceptedTranslations":["Thanks so much, that's very kind of you.","Thank you, very kind."],"audio":"/audio/es-CO/beginner/01/021.mp3","notes":["Warm, polite language of this kind is very common in everyday Colombian interactions."],"topics":["thanks","social"],"kind":"curated","family":"gracias"},
    {"id":"es-co-beginner-01-022","sentence":"Con mucho gusto.","english":"You're very welcome.","acceptedTranslations":["My pleasure.","With pleasure."],"audio":"/audio/es-CO/beginner/01/022.mp3","notes":["A particularly common Colombian response to thanks."],"topics":["social","responses","spoken colombian spanish"],"kind":"curated","family":"youre-welcome"},
    {"id":"es-co-beginner-01-023","sentence":"A la orden.","english":"You're welcome.","acceptedTranslations":["At your service.","Happy to help."],"audio":"/audio/es-CO/beginner/01/023.mp3","notes":["A very common Colombian expression in shops, restaurants, and service interactions. You may hear it when someone offers help or responds to thanks."],"topics":["social","service","spoken colombian spanish"],"kind":"curated","family":"a-la-orden"},
    {"id":"es-co-beginner-01-024","sentence":"Listo, muchas gracias.","english":"Okay, thank you very much.","acceptedTranslations":["All right, thanks a lot.","Great, thank you."],"audio":"/audio/es-CO/beginner/01/024.mp3","notes":["In Colombia, « listo » is used constantly to mean okay, all right, agreed, or done."],"topics":["social","responses","spoken colombian spanish"],"kind":"curated","family":"listo"},
    {"id":"es-co-beginner-01-025","sentence":"Chao, que le vaya bien.","english":"Bye, take care.","acceptedTranslations":["Bye, hope everything goes well.","Goodbye, have a good one.","Bye, all the best."],"audio":"/audio/es-CO/beginner/01/025.mp3","notes":["« Que le vaya bien » is a warm and very common Colombian farewell."],"topics":["goodbyes","social","spoken colombian spanish"],"kind":"curated","family":"goodbye"}
  ]
}
