  "lessons":[
    {"id":"fr-beginner-01-001","sentence":"Bonjour !","english":"Hello!","acceptedTranslations":["Hi!","Good morning!"],"audio":"/audio/fr/beginner/01/001.mp3","notes":["The standard greeting in most situations."],"topics":["greetings","social"],"kind":"curated","family":"basic-greeting"},
    {"id":"fr-beginner-01-002","sentence":"Salut, ça va ?","english":"Hi, how are you?","acceptedTranslations":["Hey, how's it going?","Hi, are you doing okay?"],"audio":"/audio/fr/beginner/01/002.mp3","notes":[],"topics":["greetings","social"],"kind":"curated","family":"informal-greeting"},
    {"id":"fr-beginner-01-003","sentence":"Oui, ça va bien, merci.","english":"Yes, I'm doing well, thanks.","acceptedTranslations":["I'm good, thanks.","Yes, I'm fine, thank you."],"audio":"/audio/fr/beginner/01/003.mp3","notes":[],"topics":["greetings","responses"],"kind":"construction","family":"ca-va"},
    {"id":"fr-beginner-01-004","sentence":"Et vous, ça va ?","english":"And you, how are you?","acceptedTranslations":["And how are you?","How about you?"],"audio":"/audio/fr/beginner/01/004.mp3","notes":[],"topics":["greetings","social"],"kind":"construction","family":"ca-va"},
    {"id":"fr-beginner-01-005","sentence":"Je m’appelle Marie.","english":"My name is Marie.","acceptedTranslations":["I'm Marie."],"audio":"/audio/fr/beginner/01/005.mp3","notes":[],"topics":["introductions"],"kind":"construction","family":"je-mappelle"},
    {"id":"fr-beginner-01-006","sentence":"Et vous, vous vous appelez comment ?","english":"And what's your name?","acceptedTranslations":["What are you called?"],"audio":"/audio/fr/beginner/01/006.mp3","notes":[],"topics":["introductions"],"kind":"construction","family":"ask-name"},
    {"id":"fr-beginner-01-007","sentence":"Moi, c’est Paul.","english":"I'm Paul.","acceptedTranslations":["My name is Paul."],"audio":"/audio/fr/beginner/01/007.mp3","notes":[],"topics":["introductions"],"kind":"curated","family":"moi-cest"},
    {"id":"fr-beginner-01-008","sentence":"Enchanté !","english":"Nice to meet you!","acceptedTranslations":["Pleased to meet you!"],"audio":"/audio/fr/beginner/01/008.mp3","notes":[],"topics":["introductions"],"kind":"curated","family":"nice-to-meet-you"},
    {"id":"fr-beginner-01-009","sentence":"Vous êtes français ?","english":"Are you French?","acceptedTranslations":[],"audio":"/audio/fr/beginner/01/009.mp3","notes":[],"topics":["introductions"],"kind":"construction","family":"vous-etes"},
    {"id":"fr-beginner-01-010","sentence":"Non, je viens des États-Unis.","english":"No, I'm from the United States.","acceptedTranslations":["No, I come from the United States."],"audio":"/audio/fr/beginner/01/010.mp3","notes":[],"topics":["introductions"],"kind":"curated","family":"origin"},
    {"id":"fr-beginner-01-011","sentence":"Vous habitez ici ?","english":"Do you live here?","acceptedTranslations":["Are you living here?"],"audio":"/audio/fr/beginner/01/011.mp3","notes":[],"topics":["introductions"],"kind":"construction","family":"vous-question"},
    {"id":"fr-beginner-01-012","sentence":"Non, je suis ici en vacances.","english":"No, I'm here on vacation.","acceptedTranslations":["No, I'm here on holiday."],"audio":"/audio/fr/beginner/01/012.mp3","notes":[],"topics":["travel"],"kind":"curated","family":"vacation"},
    {"id":"fr-beginner-01-013","sentence":"Vous parlez anglais ?","english":"Do you speak English?","acceptedTranslations":["Can you speak English?"],"audio":"/audio/fr/beginner/01/013.mp3","notes":[],"topics":["language"],"kind":"construction","family":"vous-parlez"},
    {"id":"fr-beginner-01-014","sentence":"Je parle un peu français.","english":"I speak a little French.","acceptedTranslations":["I speak a bit of French."],"audio":"/audio/fr/beginner/01/014.mp3","notes":[],"topics":["language"],"kind":"construction","family":"je-parle"},
    {"id":"fr-beginner-01-015","sentence":"Je ne comprends pas.","english":"I don't understand.","acceptedTranslations":["I don't get it."],"audio":"/audio/fr/beginner/01/015.mp3","notes":[],"topics":["clarification"],"kind":"curated","family":"dont-understand"},
    {"id":"fr-beginner-01-016","sentence":"Vous pouvez répéter, s’il vous plaît ?","english":"Can you repeat that, please?","acceptedTranslations":["Could you repeat that, please?","Can you say that again, please?"],"audio":"/audio/fr/beginner/01/016.mp3","notes":[],"topics":["clarification"],"kind":"construction","family":"vous-pouvez"},
    {"id":"fr-beginner-01-017","sentence":"Un peu plus lentement, s’il vous plaît.","english":"A little more slowly, please.","acceptedTranslations":["A bit slower, please."],"audio":"/audio/fr/beginner/01/017.mp3","notes":[],"topics":["clarification"],"kind":"curated","family":"speak-slower"},
    {"id":"fr-beginner-01-018","sentence":"Excusez-moi, j’ai une question.","english":"Excuse me, I have a question.","acceptedTranslations":[],"audio":"/audio/fr/beginner/01/018.mp3","notes":[],"topics":["social"],"kind":"curated","family":"excusez-moi"},
    {"id":"fr-beginner-01-019","sentence":"Pardon, je n’ai pas entendu.","english":"Sorry, I didn't hear you.","acceptedTranslations":["Sorry, I didn't hear that."],"audio":"/audio/fr/beginner/01/019.mp3","notes":[],"topics":["clarification"],"kind":"curated","family":"didnt-hear"},
    {"id":"fr-beginner-01-020","sentence":"Merci beaucoup.","english":"Thank you very much.","acceptedTranslations":["Thanks a lot."],"audio":"/audio/fr/beginner/01/020.mp3","notes":[],"topics":["thanks"],"kind":"construction","family":"merci"},
    {"id":"fr-beginner-01-021","sentence":"Merci, c’est gentil.","english":"Thanks, that's kind of you.","acceptedTranslations":["Thank you, that's nice of you."],"audio":"/audio/fr/beginner/01/021.mp3","notes":[],"topics":["thanks"],"kind":"curated","family":"merci"},
    {"id":"fr-beginner-01-022","sentence":"De rien.","english":"You're welcome.","acceptedTranslations":["No problem."],"audio":"/audio/fr/beginner/01/022.mp3","notes":[],"topics":["responses"],"kind":"curated","family":"youre-welcome"},
    {"id":"fr-beginner-01-023","sentence":"Pas de problème.","english":"No problem.","acceptedTranslations":["No worries."],"audio":"/audio/fr/beginner/01/023.mp3","notes":[],"topics":["responses"],"kind":"curated","family":"no-problem"},
    {"id":"fr-beginner-01-024","sentence":"Bon, je dois y aller.","english":"Well, I have to go.","acceptedTranslations":["Well, I need to get going."],"audio":"/audio/fr/beginner/01/024.mp3","notes":[],"topics":["goodbyes"],"kind":"curated","family":"leaving"},
