  "title": "Introductions and essentials",
  "description": "Short, natural phrases for greeting people, introducing yourself, and handling basic social interactions in Spain.",
  "targetVocabulary": ["hola", "buenos días", "gracias", "por favor", "qué tal", "me llamo", "encantado", "perdona", "perdone", "vale", "hasta luego"],
  "lessons": [
    {"id":"es-beginner-01-001","sentence":"¡Hola!","english":"Hello!","acceptedTranslations":["Hi!"],"audio":"/audio/es/beginner/01/001.mp3","notes":["The most common general greeting."],"topics":["greetings","social"],"kind":"curated","family":"basic-greeting"},
    {"id":"es-beginner-01-002","sentence":"Buenos días.","english":"Good morning.","acceptedTranslations":["Good morning!"],"audio":"/audio/es/beginner/01/002.mp3","notes":["A standard greeting used in the morning."],"topics":["greetings","social"],"kind":"curated","family":"basic-greeting"},
    {"id":"es-beginner-01-003","sentence":"Hola, ¿qué tal?","english":"Hi, how are you?","acceptedTranslations":["Hi, how's it going?","Hello, how are things?"],"audio":"/audio/es/beginner/01/003.mp3","notes":["« ¿Qué tal? » is an extremely common casual greeting."],"topics":["greetings","social"],"kind":"curated","family":"que-tal"},
    {"id":"es-beginner-01-004","sentence":"Muy bien, gracias. ¿Y tú?","english":"Very well, thanks. And you?","acceptedTranslations":["I'm very well, thanks. And you?","Great, thanks. How about you?"],"audio":"/audio/es/beginner/01/004.mp3","notes":["A natural informal response to « ¿Qué tal? »."],"topics":["greetings","responses"],"kind":"construction","family":"que-tal"},
    {"id":"es-beginner-01-005","sentence":"Me llamo Ana.","english":"My name is Ana.","acceptedTranslations":["I'm Ana."],"audio":"/audio/es/beginner/01/005.mp3","notes":["The standard way to give your name."],"topics":["introductions","social"],"kind":"construction","family":"me-llamo"},
    {"id":"es-beginner-01-006","sentence":"¿Cómo te llamas?","english":"What's your name?","acceptedTranslations":["What are you called?"],"audio":"/audio/es/beginner/01/006.mp3","notes":["The common informal way to ask someone's name."],"topics":["introductions","questions"],"kind":"construction","family":"ask-name"},
    {"id":"es-beginner-01-007","sentence":"Yo soy Carlos.","english":"I'm Carlos.","acceptedTranslations":["My name is Carlos.","I am Carlos."],"audio":"/audio/es/beginner/01/007.mp3","notes":["A simple alternative way to introduce yourself."],"topics":["introductions","social"],"kind":"curated","family":"soy-name"},
    {"id":"es-beginner-01-008","sentence":"Encantado.","english":"Nice to meet you.","acceptedTranslations":["Pleased to meet you."],"audio":"/audio/es/beginner/01/008.mp3","notes":["A man typically says « encantado » and a woman « encantada »."],"topics":["introductions","social"],"kind":"curated","family":"nice-to-meet-you"},
    {"id":"es-beginner-01-009","sentence":"¿Eres de aquí?","english":"Are you from here?","acceptedTranslations":["Are you local?","Are you from around here?"],"audio":"/audio/es/beginner/01/009.mp3","notes":["A natural informal question when meeting someone."],"topics":["introductions","questions"],"kind":"curated","family":"where-from"},
    {"id":"es-beginner-01-010","sentence":"No, soy de Estados Unidos.","english":"No, I'm from the United States.","acceptedTranslations":["No, I'm from the US.","No, I'm American."],"audio":"/audio/es/beginner/01/010.mp3","notes":["« Soy de... » is the standard construction for saying where you are from."],"topics":["introductions","responses"],"kind":"construction","family":"soy-de"},
    {"id":"es-beginner-01-011","sentence":"¿Vives aquí?","english":"Do you live here?","acceptedTranslations":["Are you living here?"],"audio":"/audio/es/beginner/01/011.mp3","notes":["A common informal question in conversation."],"topics":["introductions","questions"],"kind":"curated","family":"live-here"},
    {"id":"es-beginner-01-012","sentence":"No, estoy aquí de vacaciones.","english":"No, I'm here on vacation.","acceptedTranslations":["No, I'm here on holiday."],"audio":"/audio/es/beginner/01/012.mp3","notes":["« Estar de vacaciones » means to be on vacation."],"topics":["introductions","travel"],"kind":"curated","family":"vacation"},
    {"id":"es-beginner-01-013","sentence":"¿Hablas inglés?","english":"Do you speak English?","acceptedTranslations":["Can you speak English?"],"audio":"/audio/es/beginner/01/013.mp3","notes":["The informal singular form of a very useful question."],"topics":["language","questions"],"kind":"construction","family":"hablas"},
    {"id":"es-beginner-01-014","sentence":"Hablo un poco de español.","english":"I speak a little Spanish.","acceptedTranslations":["I speak a bit of Spanish."],"audio":"/audio/es/beginner/01/014.mp3","notes":["« Un poco de » means a little or a bit of."],"topics":["language","introductions"],"kind":"construction","family":"hablo"},
    {"id":"es-beginner-01-015","sentence":"No entiendo.","english":"I don't understand.","acceptedTranslations":["I don't get it."],"audio":"/audio/es/beginner/01/015.mp3","notes":["An essential phrase when you lose track of a conversation."],"topics":["clarification","language"],"kind":"curated","family":"dont-understand"},
    {"id":"es-beginner-01-016","sentence":"¿Puedes repetir, por favor?","english":"Can you repeat that, please?","acceptedTranslations":["Could you repeat that, please?","Can you say that again, please?"],"audio":"/audio/es/beginner/01/016.mp3","notes":["A natural informal request when you did not understand or hear something."],"topics":["clarification","requests"],"kind":"construction","family":"puedes"},
    {"id":"es-beginner-01-017","sentence":"Más despacio, por favor.","english":"More slowly, please.","acceptedTranslations":["A little slower, please.","Could you speak more slowly?"],"audio":"/audio/es/beginner/01/017.mp3","notes":["A short, natural request when someone is speaking too quickly."],"topics":["clarification","requests"],"kind":"curated","family":"speak-slower"},
    {"id":"es-beginner-01-018","sentence":"Perdona, tengo una pregunta.","english":"Excuse me, I have a question.","acceptedTranslations":["Sorry, I have a question."],"audio":"/audio/es/beginner/01/018.mp3","notes":["« Perdona » is a common informal way to get someone's attention."],"topics":["social","requests"],"kind":"curated","family":"perdona"},
    {"id":"es-beginner-01-019","sentence":"Perdone, no he oído bien.","english":"Sorry, I didn't hear you clearly.","acceptedTranslations":["Excuse me, I didn't hear that well.","Sorry, I didn't hear you properly."],"audio":"/audio/es/beginner/01/019.mp3","notes":["« Perdone » is useful with strangers when you want to be polite."],"topics":["clarification","social"],"kind":"curated","family":"didnt-hear"},
    {"id":"es-beginner-01-020","sentence":"Muchas gracias.","english":"Thank you very much.","acceptedTranslations":["Thanks a lot."],"audio":"/audio/es/beginner/01/020.mp3","notes":["A very common way to express stronger thanks."],"topics":["social","thanks"],"kind":"construction","family":"gracias"},
    {"id":"es-beginner-01-021","sentence":"Gracias, muy amable.","english":"Thank you, that's very kind.","acceptedTranslations":["Thanks, that's very kind of you.","Thank you, very kind."],"audio":"/audio/es/beginner/01/021.mp3","notes":["A natural polite response when someone helps you."],"topics":["social","thanks"],"kind":"curated","family":"gracias"},
    {"id":"es-beginner-01-022","sentence":"De nada.","english":"You're welcome.","acceptedTranslations":["No problem."],"audio":"/audio/es/beginner/01/022.mp3","notes":["The standard response to « gracias »."],"topics":["social","responses"],"kind":"curated","family":"youre-welcome"},
    {"id":"es-beginner-01-023","sentence":"Vale, perfecto.","english":"Okay, perfect.","acceptedTranslations":["All right, perfect.","Okay, great."],"audio":"/audio/es/beginner/01/023.mp3","notes":["« Vale » is extremely common in Spain and means okay or all right."],"topics":["social","responses","spoken spanish"],"kind":"curated","family":"vale"},
    {"id":"es-beginner-01-024","sentence":"Bueno, me tengo que ir.","english":"Well, I have to go.","acceptedTranslations":["Okay, I have to go.","Well, I need to get going."],"audio":"/audio/es/beginner/01/024.mp3","notes":["« Bueno » is often used conversationally to signal a transition, such as preparing to leave."],"topics":["social","goodbyes","spoken spanish"],"kind":"curated","family":"leaving"},
    {"id":"es-beginner-01-025","sentence":"Hasta luego, nos vemos.","english":"See you later.","acceptedTranslations":["See you later, see you around.","Bye, see you."],"audio":"/audio/es/beginner/01/025.mp3","notes":["Two extremely common ways to say goodbye in everyday Spanish."],"topics":["goodbyes","social"],"kind":"curated","family":"goodbye"}
  ]
}
